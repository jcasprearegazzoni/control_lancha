
(rules PCB freerouting.dsn
  (snapAngle 
    fortyfive_degree
  )
  (rule
    (width 700.0)
    (clearance 500.0)
    (clearance 350.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 500.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_2100:800_um"
    (shape
      (circle F.Cu 2100.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 2100.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_2100:800_um" "Via[0-1]_2100:800_um" default
  )
  (viaRule
    default "Via[0-1]_2100:800_um"
  )
  (viaRule
    default "Via[0-1]_2100:800_um"
  )
  (class default
    GND "S-BUS" Puls "Net-(Q3-B)" "Net-(J6-Pin_4)" "Net-(Q4-B)" "unconnected-(A2-3.3V-Pad3V3)" +5V
    "unconnected-(A2-PadA0)" "unconnected-(A2-PadA1)" "unconnected-(A2-PadA2)" "unconnected-(A2-PadA3)" "unconnected-(A2-PadA4)" "unconnected-(A2-PadA5)" "unconnected-(A2-PadA6)" "unconnected-(A2-PadA7)"
    "Net-(J7-Pin_2)" "unconnected-(A2-PadA9)" "unconnected-(A2-PadA10)" "unconnected-(A2-PadA11)" "unconnected-(A2-PadA12)" "unconnected-(A2-PadA13)" "unconnected-(A2-PadA14)" "unconnected-(A2-PadA15)"
    "unconnected-(A2-PadAREF)" "unconnected-(A2-D0{slash}RX0-PadD0)" "unconnected-(A2-D1{slash}TX0-PadD1)" "Net-(A2-D2_INT0)" "Net-(A2-D3_INT1)" PWM Dir Enable
    "unconnected-(A2-PadD8)" "unconnected-(A2-PadD9)" "unconnected-(A2-PadD10)" "unconnected-(A2-PadD11)" "unconnected-(A2-PadD12)" "unconnected-(A2-PadD13)" "unconnected-(A2-D14{slash}TX3-PadD14)" "unconnected-(A2-D16{slash}TX2-PadD16)"
    "unconnected-(A2-D17{slash}RX2-PadD17)" "unconnected-(A2-D18{slash}TX1-PadD18)" "unconnected-(A2-D19{slash}RX1-PadD19)" "unconnected-(A2-D20{slash}SDA-PadD20)" "unconnected-(A2-D21{slash}SCL-PadD21)" "unconnected-(A2-GND-PadGND2)" "unconnected-(A2-IOREF-PadIORF)" "unconnected-(A2-RESET-PadRST1)"
    "unconnected-(A2-PadSCL)" "unconnected-(A2-PadSDA)" +9V /Seguridad "Net-(J6-Pin_2)" "Net-(J6-Pin_6)" "Net-(Q1-B)" "/V_Ctrl"
    "Net-(Q2-B)" "Net-(Q5-B)" "Net-(D1-A)" "Net-(U1A-+)" "/Power_on_motor" "Net-(J1-Pin_3)" "Analog_out" "unconnected-(K1-Pad12)"
    "/Power_on_relay" "unconnected-(U1B-+-Pad5)"
    (clearance_class default)
    (via_rule default)
    (rule
      (width 700.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)